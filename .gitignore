# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# IDE-specific files
.idea/
.vscode/

# OS-specific files
.DS_Store
Thumbs.db

# Log files
*.log

# Binary output directory
bin/

# Environment variables file
.env

# Temporary files
*.tmp
*.swp
*.swo

# If you're using Air for live reloading
tmp/

# If you're using a local config that shouldn't be committed
config.local.yaml

# Ignore any files in the root directory that start with "local_"
/local_*
